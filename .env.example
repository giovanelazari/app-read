POSTGRES_USER=kindle
POSTGRES_PASSWORD=trocar-aqui
POSTGRES_DB=kindle_highlights
DATABASE_URL=postgresql+psycopg://kindle:trocar-aqui@db:5432/kindle_highlights

WEB_HOST=kindle.giovanelazari.com.br
API_HOST=kindle-api.giovanelazari.com.br
WEB_URL=https://kindle.giovanelazari.com.br

VAPID_CLAIM_EMAIL=mailto:voicproducoes@gmail.com

# Traefik in Docker Swarm mode is already configured on the VPS to watch this external network.
# Adjust if your Traefik watches a different one.
TRAEFIK_NETWORK=network_swarm_public

# Name of the certresolver in your Traefik static config. On Giovane's VPS this is
# `letsencryptresolver`. If you copy this stack to another host, match the name there.
TRAEFIK_CERTRESOLVER=letsencryptresolver
